<%- include('../partials/top', { title: L.home }) %>
<% const b = d.boat; const S = { ok: L.st_ok, warn: L.st_warn, bad: L.st_bad, none: L.st_none }; %>
<main class="app-main" id="main">
<%- include('../partials/boatpicker') %>
<%- include('../partials/flash') %>
<div class="page-top">
<div>
<p class="eyebrow"><%= L[b.tipo] || b.tipo %><%= b.lunghezza ? ' · ' + b.lunghezza + ' m' : '' %></p>
<h1><%= b.nome || '—' %></h1>
<p class="sub"><%= [b.targa, b.porto, b.posto_barca].filter(Boolean).join(' · ') %></p>
</div>
<a class="btn btn-wa" href="/area/richiesta" target="_blank" rel="noopener"><%= L.request_wa %></a>
</div>

<div class="tiles">
<a class="panel tile-link span2" href="/area/manutenzione">
<span class="panel-head" style="margin:0"><h2><%= L.maintenance %></h2><span class="more"><%= L.open %> →</span></span>
<span class="two">
<span class="mini">
<span class="mini-label"><%= L.cleaning %></span>
<span class="dot" style="color:<%= COLORS[d.cleaningStatus] %>">● <%= S[d.cleaningStatus] %></span>
<span class="mini-note"><%= d.last ? L.last_job + ' ' + fmtDate(d.last.data) + ' · ' + d.last.photos.length + ' ' + L.photos : L.none_yet %></span>
</span>
<span class="mini">
<span class="mini-label"><%= L.anodes %></span>
<span class="dot" style="color:<%= COLORS[d.anodesStatus] %>">● <%= d.anodes.length ? S[d.anodesStatus] : L.st_none %></span>
<span class="mini-note"><%= d.anodes.length %> <%= lang === 'en' ? (d.anodes.length === 1 ? 'anode' : 'anodes') : (d.anodes.length === 1 ? 'anodo' : 'anodi') %><%= d.anodesToCheck ? ' · ' + d.anodesToCheck + ' ' + (lang === 'en' ? 'to check' : 'da controllare') : '' %></span>
</span>
</span>
<span class="row-kv"><span><%= L.next_job %></span><strong><%= b.prox_pulizia ? fmtDate(b.prox_pulizia) : L.no_reminder %></strong></span>
</a>

<a class="panel tile-link" href="/area/scheda">
<span class="panel-head" style="margin:0"><h2><%= L.boat_sheet %></h2><span class="more"><%= L.edit %> →</span></span>
<span class="hint"><%= L.sheet_hint %></span>
<span class="row-kv"><span><%= L.insurance %></span><strong><%= b.scad_assicurazione ? L.expires + ' ' + fmtDate(b.scad_assicurazione) : '—' %></strong></span>
<span class="row-kv"><span><%= L.completeness %></span><strong><%= d.completeness %>%</strong></span>
</a>

</div>
</main>
<%- include('../partials/bottom') %>
