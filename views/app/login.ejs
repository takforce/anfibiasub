<%- include('../partials/top', { title: L.login_title }) %>
<div class="login">
<div class="login-art">
<img src="/img/sostituzione-anodi.webp" alt="">
<div class="in">
<a class="logo" href="/" aria-label="<%= L.site %>"><img src="/img/logo-anfibia-96.png" alt="" width="64" height="64" style="border-radius:50%"><span class="logo-name" style="color:#fff">ANFIBIA<span class="hl">SUB</span></span></a>
<div>
<p class="eyebrow"><%= L.area %></p>
<h1 class="h2" style="font-size:clamp(34px,4.5vw,54px)"><%= L.hero_area %><br><span class="hl"><%= L.hero_area2 %></span></h1>
<p style="max-width:520px;color:#C9D8E3;font-size:17px"><%= L.hero_lead %></p>
</div>
<p class="hint">Porto di Loano (SV)</p>
</div>
</div>
<main class="login-form" id="main">
<div class="lang-switch" style="margin-bottom:30px"><a href="?lang=it" aria-current="<%= lang === 'it' %>">IT</a><a href="?lang=en" aria-current="<%= lang === 'en' %>">EN</a></div>
<h2 style="font-weight:800;font-size:30px;margin-bottom:6px"><%= L.login_title %></h2>
<p class="hint" style="margin-bottom:28px"><%= L.login_sub %></p>
<%- include('../partials/flash') %>
<% if (error) { %><div class="msg err" role="alert"><%= error %></div><% } %>
<form class="form" method="post" action="/area/login">
<label class="field"><%= L.email %><input type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus></label>
<label class="field"><%= L.password %><input type="password" name="password" autocomplete="current-password" required></label>
<div style="display:flex;justify-content:flex-end;font-size:13px"><a href="/area/password"><%= L.forgot %></a></div>
<button class="btn" type="submit" style="justify-content:center"><%= L.enter.toUpperCase() %></button>
</form>
<p class="hint" style="margin-top:30px"><%= L.no_access %> <a href="https://wa.me/393470119832" target="_blank" rel="noopener"><%= L.write_wa %></a></p>
<p class="hint" style="margin-top:8px"><a href="/<%= lang === 'en' ? 'en/' : '' %>">← <%= L.site %></a></p>
</main>
</div>
<%- include('../partials/bottom') %>
