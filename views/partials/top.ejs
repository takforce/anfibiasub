<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Anfibiasub</title>
<meta name="theme-color" content="#050E1A">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/app.css">
<% if (typeof leaflet !== 'undefined' && leaflet) { %><link rel="stylesheet" href="/vendor/leaflet/leaflet.css"><% } %>
</head>
<body>
<% if (user) { const admin = user.role === 'admin'; %>
<header class="app-header">
<div class="wrap nav-row">
<a class="logo" href="<%= admin ? '/admin' : '/area/home' %>" aria-label="Anfibiasub">
<span class="logo-mark"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="9" r="5"/><circle cx="12" cy="9" r="2"/><path d="M3 18c2 0 2-1.5 4.5-1.5S9.5 18 12 18s2.5-1.5 4.5-1.5S19 18 21 18"/></svg></span>
<span class="logo-name">ANFIBIA<span class="hl">SUB</span></span><span class="app-tag"><%= admin ? 'GESTIONE' : L.area.toUpperCase() %></span>
</a>
<nav class="app-nav" aria-label="<%= L.area %>">
<% if (admin) { %>
<a href="/admin"<%- path === '/admin' || path.startsWith('/admin/barca') ? ' aria-current="page"' : '' %>>Clienti e barche</a>
<a href="/admin/clienti/nuovo"<%- path === '/admin/clienti/nuovo' ? ' aria-current="page"' : '' %>>Nuovo cliente</a>
<a href="/admin/impostazioni"<%- path === '/admin/impostazioni' ? ' aria-current="page"' : '' %>>Impostazioni</a>
<% } else { %>
<a href="/area/home"<%- path === '/area/home' ? ' aria-current="page"' : '' %>><%= L.home %></a>
<a href="/area/scheda"<%- path === '/area/scheda' ? ' aria-current="page"' : '' %>><%= L.boat_sheet %></a>
<a href="/area/manutenzione"<%- path === '/area/manutenzione' ? ' aria-current="page"' : '' %>><%= L.maintenance %></a>
<a href="/area/posizione"<%- path === '/area/posizione' ? ' aria-current="page"' : '' %>><%= L.position %></a>
<% } %>
<a href="/area/profilo"<%- path === '/area/profilo' ? ' aria-current="page"' : '' %>><%= user.name ? user.name.split(' ')[0] : L.profile %></a>
<form method="post" action="/area/logout"><button class="linkbtn" type="submit"><%= L.logout %></button></form>
</nav>
</div>
</header>
<% } %>
